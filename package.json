{
  "name": "profile-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd timeline-scratch && npm install && npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "shots": "node scripts/lifelines-shots.mjs"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant": "^5.3.0",
    "@playwright/test": "^1.48.2",
    "jsdom": "^25.0.1",
    "serve": "^14.2.4",
    "vitest": "^2.1.8"
  }
}
